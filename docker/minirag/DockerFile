FROM python:3.13.14-slim-trixie
RUN pip install --no-cache-dir uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    linux-libc-dev \
    libffi-dev \
    libpq-dev \
    pkg-config \
    libavif-dev \
    libjpeg-dev \
    unzip \
    zip \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*




COPY uv.lock pyproject.toml ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

COPY src/ .



COPY docker/minirag/alembic.ini /app/docker/models/db_schemas/minirag26/alembic.ini
COPY src/models/db_schemas/minirag26/alembic /app/docker/models/db_schemas/minirag26/alembic
COPY docker/minirag/entrypoint.sh ./entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENV PYTHONPATH="/app:/app/models/db_schemas/minirag26"

ENTRYPOINT [ "/app/entrypoint.sh" ]

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
